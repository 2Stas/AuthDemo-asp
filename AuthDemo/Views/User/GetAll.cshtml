@model List<AuthDemo.Models.User>

@{
    ViewData["Title"] = "Список користувачів";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Список користувачів</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Додати користувача
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info" role="alert">
            Користувачів поки немає.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover border">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">ID</th>
                        <th scope="col">Логін / Ім'я</th>
                        <th scope="col">Роль</th>
                        <th scope="col" class="text-end">Дії</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.id</td>
                            <td>@user.name</td>
                            <td>
                                @if (user.role == "ProUser")
                                {
                                    <span class="badge bg-success">ProUser</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">DefaultUser</span>
                                }
                            </td>
                            <td class="text-end">
                                <form asp-action="Delete" asp-route-id="@user.id" method="post" onsubmit="return confirm('Ви впевнені, що хочете видалити цього користувача?');" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        Видалити
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>