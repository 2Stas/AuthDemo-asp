@model AuthDemo.DTOs.UserDto

@{
	ViewData["Title"] = "My Data";
}

<div class="container mt-4">
	<h2>@ViewData["Title"]</h2>

	<div class="card mt-3">
		<div class="card-body">
			<h5 class="card-title">@Model.Name</h5>
			<p class="card-text"><strong>Email:</strong> @Model.Email</p>
			<p class="card-text"><strong>Role:</strong> @Model.Role</p>
		</div>
	</div>

	<div class="mt-3">
		@if (Model.Role == AuthDemo.Models.User.RolePro)
		{
			<a asp-controller="User" asp-action="GetAllUsers" asp-route-currentUserId="@Model.Id" class="btn btn-primary">View all users</a>
			<a asp-controller="Account" asp-action="Register" class="btn btn-success">Add new user</a>
		}
		<a asp-controller="Home" asp-action="Index" class="btn btn-secondary">Home</a>
		<a asp-controller="Account" asp-action="Login" class="btn btn-link">Logout / Login</a>
	</div>
</div>
